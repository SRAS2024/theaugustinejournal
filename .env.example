# Required — Railway provides DATABASE_URL automatically when a Postgres service is attached.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB

# Required — admin login credentials
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# Recommended — keeps admins signed in across restarts and signs unsubscribe links
# SESSION_SECRET=some-long-random-string

# Optional — defaults to 8080
# PORT=8080

# Optional — canonical site URL used in sitemap, robots.txt and emails (no trailing slash)
# SITE_URL=https://theaugustinejournal.com

# Optional — Resend API key for emails, and the time zone of the Thursday throwback email
# RESEND_API_KEY=re_...
# THROWBACK_TIMEZONE=America/Chicago

# Optional — IndexNow notifies search engines (Bing, DuckDuckGo, Yandex, …)
# the moment a post is added, edited, or removed so it gets crawled promptly.
# Set INDEXNOW_DISABLED=true to turn the pings off entirely.
# INDEXNOW_KEY=your-32-char-hex-key
# INDEXNOW_DISABLED=false

# Optional — the self-hosted translation engine
# TRANSLATION_DISABLED=true        # skip model downloads (e.g. local development)
# TRANSLATION_THREADS=4
# TRANSLATION_BEAMS=4
# TRANSLATION_MODEL_DIR=.cache/translation-models

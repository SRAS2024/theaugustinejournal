# Required
# Railway provides DATABASE_URL automatically when a Postgres service is attached.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB

# Strongly recommended for Prisma migrations on managed platforms.
# Set this to a direct, non pooled connection string (same DB, not the pooler).
# In Railway, this is usually the "Postgres Connection URL" (not the pooled one).
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DB

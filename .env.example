# Railway provides PORT and DATABASE_URL automatically when configured
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB

# Strong random string
SESSION_SECRET=change-this-to-a-long-random-string

# Optional: provide a LibreTranslate-compatible endpoint for content translation
# Example: https://libretranslate.yourdomain.com
TRANSLATE_API_URL=

# Optional: api key if your translate server needs it
TRANSLATE_API_KEY=

# Optional: set to disable ssl for local postgres
PGSSLMODE=disable
NODE_ENV=development

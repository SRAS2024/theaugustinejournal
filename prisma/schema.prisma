generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostType {
  BLOG
  LETTER
}

enum ContentType {
  RICH
  PDF
}

model SiteSettings {
  id             Int      @id @default(1)
  aboutHtml      String   @default("<p>Welcome to The Augustine Journal. This text is an example. You can edit it in the administrative site.</p>")
  updatedAt      DateTime @updatedAt
}

model Notice {
  id        String   @id
  message   String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id          String     @id
  slug        String     @unique
  type        PostType
  title       String
  postDate    DateTime
  contentType ContentType
  contentHtml String     @default("")
  pdfPath     String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([type, postDate])
  @@index([postDate])
}

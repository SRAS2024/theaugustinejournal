// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostType {
  BLOG
  ESSAY
  LETTER
}

enum ContentType {
  RICH
  PDF
}

model SiteSettings {
  id        Int      @id @default(1)
  aboutHtml String   @default("<p>The Augustine Journal is a publication dedicated to thoughtful reflection and discourse. Founded on the principles of truth, wisdom, and intellectual inquiry, we seek to engage readers through carefully curated essays, letters, and commentary on the matters that shape our understanding of the world.</p>")
  updatedAt DateTime @updatedAt
}

model Notice {
  id        String   @id
  message   String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id                 String      @id
  slug               String      @unique
  type               PostType
  title              String
  postDate           DateTime    @default(now())
  contentType        ContentType
  contentHtml        String      @default("")
  pdfPath            String?     @db.Text
  /// Number of reads (src/lib/reads.js). The column is still named view_count:
  /// the views counted before reads existed are kept as the starting number.
  viewCount          Int         @default(0) @map("view_count")
  shareCount         Int         @default(0) @map("share_count")
  autoTranslateTitle Boolean     @default(true) @map("auto_translate_title")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  views     PostView[]
  reads     PostRead[]
  redirects PostRedirect[]

  @@index([type, postDate])
  @@index([postDate])
}

/// Unique page views from before reads were counted. Kept as history;
/// nothing writes to it any more.
model PostView {
  id               String   @id
  postId           String   @map("post_id")
  viewerIdentifier String   @map("viewer_identifier")
  createdAt        DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, viewerIdentifier])
  @@map("post_views")
}

/// One row per reader that has read a post (src/lib/reads.js). The reader key
/// is a keyed hash that includes the post, so rows of different posts cannot
/// be linked to one reader.
model PostRead {
  id         String   @id
  postId     String   @map("post_id")
  /// The device (or, without one, the network address and browser)
  readerKey  String   @map("reader_key")
  /// SHA-256 of the read ticket that counted this read (a ticket counts once)
  ticketHash String?  @unique @map("ticket_hash")
  /// 16-bit keyed tag of the reader's network, for the daily per-network cap
  networkTag String   @map("network_tag")
  createdAt  DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, readerKey])
  @@index([postId, networkTag, createdAt])
  @@map("post_reads")
}

model PdfFile {
  id        String   @id
  filename  String   @unique
  data      Bytes
  mimeType  String   @default("application/pdf")
  size      Int
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id
  email     String   @unique
  language  String   @default("en")
  createdAt DateTime @default(now())
}

model EmailLog {
  id     String   @id
  type   String // "WEEKLY_THROWBACK" or "NEW_POST"
  postId String   @map("post_id")
  sentAt DateTime @default(now()) @map("sent_at")

  @@index([type, sentAt])
  @@map("email_logs")
}

model ThrowbackTracker {
  id             Int    @id @default(1)
  lastSentPostId String @default("") @map("last_sent_post_id")
  lastSentDate   String @default("") @map("last_sent_date")

  @@map("throwback_tracker")
}

model Translation {
  id         String   @id
  lang       String
  sourceHash String   @map("source_hash")
  source     String
  text       String
  model      String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([lang, sourceHash])
  @@map("translations")
}

/// Old post URLs that redirect to the post's current slug.
model PostRedirect {
  slug      String   @id
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_redirects")
}

<!doctype html>
<html lang="en" data-title-key="dashboard">
  <head>
<%- include("../partials/admin-head") %>
    <title>Dashboard | The Augustine Journal</title>
  </head>
  <body>
    <%- include("../partials/admin-nav", { current: "dashboard" }) %>

    <main class="container">
      <section class="section card">
        <h2 class="listTitle" data-i18n="dashboard">Dashboard</h2>

        <% if (saved) { %>
          <div class="alert-success" role="status" data-i18n="changesSaved">Changes saved successfully.</div>
        <% } %>

        <div class="grid2" style="margin-bottom:20px;">
          <div class="stat-card">
            <div class="stat-label" data-i18n="totalPosts">Total Posts</div>
            <div class="stat-value"><%= postCount %></div>
          </div>
          <div class="stat-card">
            <div class="stat-label" data-i18n="blogPosts">Blog Posts</div>
            <div class="stat-value"><%= blogCount %></div>
          </div>
          <div class="stat-card">
            <div class="stat-label" data-i18n="essays">Essays</div>
            <div class="stat-value"><%= essayCount %></div>
          </div>
          <div class="stat-card">
            <div class="stat-label" data-i18n="letters">Letters</div>
            <div class="stat-value"><%= letterCount %></div>
          </div>
          <div class="stat-card">
            <div class="stat-label" data-i18n="notices">Notices</div>
            <div class="stat-value"><%= (notices || []).length %> / 3</div>
          </div>
          <a href="/admin/subscribers" class="stat-card stat-card-link" style="text-decoration:none;">
            <div class="stat-label" data-i18n="subscribers">Subscribers</div>
            <div class="stat-value"><%= subscriberCount %></div>
          </a>
        </div>

        <div style="display:flex;justify-content:center;gap:10px;flex-wrap:wrap;">
          <a class="btn primary" href="/admin/posts/new" data-i18n="createPost">Create Post</a>
          <a class="btn" href="/admin/posts" data-i18n="managePosts">Manage Posts</a>
          <a class="btn" href="/admin/settings" data-i18n="siteSettings">Site Settings</a>
        </div>
      </section>
    </main>

    <script src="/public/js/i18n.js"></script>
  </body>
</html>

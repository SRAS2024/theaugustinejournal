<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Dashboard | The Augustine Journal</title>
    <link rel="icon" href="/public/icons/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/public/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/public/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/public/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/public/css/styles.css" />
  </head>
  <body>
    <header class="topbar">
      <div class="container header-inner">
        <h1 class="brand"><a href="/admin/dashboard" style="color:inherit;text-decoration:none;">The Augustine Journal</a></h1>
        <nav class="admin-nav">
          <a href="/">View Site</a>
          <a href="/admin/dashboard" class="active">Dashboard</a>
          <a href="/admin/posts">Posts</a>
          <a href="/admin/settings">Site Settings</a>
          <form method="POST" action="/admin/logout" style="display:inline;margin:0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit">Log out</button>
          </form>
        </nav>
      </div>
    </header>

    <main class="container">
      <section class="section card">
        <h2 class="listTitle">Dashboard</h2>

        <% if (saved) { %>
          <div class="alert-success">Changes saved successfully.</div>
        <% } %>

        <div class="grid2" style="margin-bottom:20px;">
          <div class="stat-card">
            <div class="stat-label">Total Posts</div>
            <div class="stat-value"><%= postCount %></div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Blog Posts</div>
            <div class="stat-value"><%= blogCount %></div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Essays</div>
            <div class="stat-value"><%= essayCount %></div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Letters</div>
            <div class="stat-value"><%= letterCount %></div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Notices</div>
            <div class="stat-value"><%= (notices || []).length %> / 3</div>
          </div>
        </div>

        <div style="display:flex;justify-content:center;gap:10px;flex-wrap:wrap;">
          <a class="btn primary" href="/admin/posts/new">Create Post</a>
          <a class="btn" href="/admin/posts">Manage Posts</a>
          <a class="btn" href="/admin/settings">Site Settings</a>
        </div>
      </section>
    </main>
  </body>
</html>

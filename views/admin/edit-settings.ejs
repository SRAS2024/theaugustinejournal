<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Site Settings | The Augustine Journal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/public/css/styles.css" />
  </head>
  <body>
    <header class="topbar">
      <div class="container header-inner">
        <h1 class="brand">The Augustine Journal</h1>
        <nav class="admin-nav">
          <a href="/">View Site</a>
          <a href="/admin/dashboard">Dashboard</a>
          <a href="/admin/posts">Posts</a>
          <a href="/admin/settings" class="active">Site Settings</a>
          <form method="POST" action="/admin/logout" style="display:inline;margin:0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit">Log out</button>
          </form>
        </nav>
      </div>
    </header>

    <main class="container">
      <section class="section card">
        <h2 class="listTitle">Site Settings</h2>

        <% if (saved) { %>
          <div class="alert-success">Changes saved successfully.</div>
        <% } %>

        <!-- About Text -->
        <div style="margin-bottom:28px;">
          <label class="form-label" style="font-size:14px;margin-bottom:10px;">Home Page Text</label>

          <form method="POST" action="/admin/settings">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <textarea name="aboutHtml" rows="6" class="form-input" style="margin-bottom:12px;"><%= settings?.aboutHtml || '' %></textarea>
            <button class="btn primary" type="submit">Save</button>
          </form>
        </div>

        <hr class="divider" />

        <!-- Notices -->
        <div>
          <label class="form-label" style="font-size:14px;margin-bottom:10px;">Notices (max 3)</label>

          <div style="display:grid;gap:10px;margin-bottom:14px;">
            <% (notices || []).forEach(function(n) { %>
              <div class="postRow" style="align-items:center;">
                <form method="POST" action="/admin/notices/<%= n.id %>/update" style="flex:1;display:flex;gap:8px;align-items:center;margin:0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input name="message" value="<%= n.message %>" required class="form-input" />
                  <button class="btn" type="submit">Save</button>
                </form>

                <form method="POST" action="/admin/notices/<%= n.id %>/delete" style="margin:0;" onsubmit="return confirm('Delete this notice?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn danger" type="submit">Delete</button>
                </form>
              </div>
            <% }) %>
          </div>

          <% if ((notices || []).length < 3) { %>
            <form method="POST" action="/admin/notices/add" style="display:flex;gap:8px;align-items:center;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input name="message" placeholder="Add a notice&hellip;" required class="form-input" />
              <button class="btn primary" type="submit" style="white-space:nowrap;">Add Notice</button>
            </form>
          <% } else { %>
            <div class="muted" style="text-align:center;font-size:13px;">Maximum of 3 notices reached.</div>
          <% } %>
        </div>
      </section>
    </main>
  </body>
</html>

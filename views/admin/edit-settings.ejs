<!doctype html>
<html lang="en" data-title-key="siteSettings">
  <head>
<%- include("../partials/admin-head") %>
    <title>Site Settings | The Augustine Journal</title>
  </head>
  <body>
    <%- include("../partials/admin-nav", { current: "settings" }) %>

    <main class="container">
      <section class="section card">
        <h2 class="listTitle" data-i18n="siteSettings">Site Settings</h2>

        <% if (saved) { %>
          <div class="alert-success" role="status" data-i18n="changesSaved">Changes saved successfully.</div>
        <% } %>

        <!-- About Text -->
        <div style="margin-bottom:28px;">
          <label class="form-label" for="aboutHtml" style="font-size:14px;margin-bottom:10px;" data-i18n="homePageText">Home Page Text</label>

          <form method="POST" action="/admin/settings">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <textarea id="aboutHtml" name="aboutHtml" rows="6" class="form-input" style="margin-bottom:12px;"><%= settings?.aboutHtml || '' %></textarea>
            <button class="btn primary" type="submit" data-i18n="save">Save</button>
          </form>
        </div>

        <hr class="divider" />

        <!-- Notices -->
        <div>
          <h3 class="form-label" style="font-size:14px;margin-bottom:10px;" data-i18n="noticesMax3">Notices (max 3)</h3>

          <div style="display:grid;gap:10px;margin-bottom:14px;">
            <% (notices || []).forEach(function(n) { %>
              <div class="postRow" style="align-items:center;">
                <form method="POST" action="/admin/notices/<%= encodeURIComponent(n.id) %>/update" style="flex:1;display:flex;gap:8px;align-items:center;margin:0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input name="message" value="<%= n.message %>" required maxlength="500" class="form-input" aria-label="Notice" />
                  <button class="btn" type="submit" data-i18n="save">Save</button>
                </form>

                <form method="POST" action="/admin/notices/<%= encodeURIComponent(n.id) %>/delete" style="margin:0;" data-i18n-confirm="deleteNoticeConfirm">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn danger" type="submit" data-i18n="delete_">Delete</button>
                </form>
              </div>
            <% }) %>
          </div>

          <% if ((notices || []).length < 3) { %>
            <form method="POST" action="/admin/notices/add" style="display:flex;gap:8px;align-items:center;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input name="message" data-i18n-placeholder="addNoticePlaceholder" placeholder="Add a notice&hellip;" required maxlength="500" class="form-input" aria-label="New notice" />
              <button class="btn primary" type="submit" style="white-space:nowrap;" data-i18n="addNotice">Add Notice</button>
            </form>
          <% } else { %>
            <div class="muted" style="text-align:center;font-size:13px;" data-i18n="maxNoticesReached">Maximum of 3 notices reached.</div>
          <% } %>
        </div>
      </section>
    </main>

    <script src="/public/js/i18n.js"></script>
  </body>
</html>

<!doctype html>
<html lang="<%= typeof detectedLang !== 'undefined' ? detectedLang : 'en' %>" translate="yes">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="detected-lang" content="<%= typeof detectedLang !== 'undefined' ? detectedLang : 'en' %>" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Administrative Site | The Augustine Journal</title>
    <link rel="icon" href="/public/icons/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/public/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/public/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/public/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/public/css/styles.css" />
  </head>
  <body>
    <header class="topbar">
      <div class="container header-inner">
        <h1 class="brand notranslate">The Augustine Journal</h1>
        <div class="admin-nav">
          <span class="muted" data-i18n="adminSite">Administrative Site</span>
        </div>
      </div>
    </header>

    <main class="container" style="max-width:480px;">
      <section class="section card">
        <h2 class="listTitle" style="margin-bottom:16px;" data-i18n="adminSite">Administrative Site</h2>

        <% if (error) { %>
          <div class="alert-error" data-i18n="invalidCredentials"><%= error %></div>
        <% } %>

        <form method="POST" action="/admin/login">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <div style="margin-bottom:14px;">
            <label class="form-label" for="username" data-i18n="username">Username</label>
            <input id="username" name="username" type="text" required class="form-input" autocomplete="username" />
          </div>

          <div style="margin-bottom:18px;">
            <label class="form-label" for="password" data-i18n="password">Password</label>
            <input id="password" name="password" type="password" required class="form-input" autocomplete="current-password" />
          </div>

          <button class="btn primary" type="submit" style="width:100%;" data-i18n="signIn">Sign in</button>
        </form>
      </section>
    </main>

    <script src="/public/js/i18n.js"></script>
  </body>
</html>

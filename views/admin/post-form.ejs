<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title><%= mode === 'create' ? 'Create Post' : 'Edit Post' %> | The Augustine Journal</title>
    <link rel="stylesheet" href="/public/css/styles.css" />
    <link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet">
    <style>
      .ql-toolbar.ql-snow, .ql-container.ql-snow{
        border-color: rgba(255,255,255,0.12);
        background: rgba(0,0,0,0.12);
        color: var(--text);
      }
      .ql-container{
        min-height: 220px;
        border-radius: 0 0 14px 14px;
      }
      .ql-toolbar{
        border-radius: 14px 14px 0 0;
      }
      .ql-editor{
        color: var(--text);
        font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="container">
        <h1 class="brand">The Augustine Journal</h1>
        <nav class="nav">
          <a href="/" class="">View Site</a>
          <a href="/admin/dashboard">Dashboard</a>
          <a href="/admin/posts" class="active">Posts</a>
          <a href="/admin/settings">Site Settings</a>
          <form method="POST" action="/admin/logout" style="display:inline;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button class="btn" type="submit" style="padding:8px 12px;">Log out</button>
          </form>
        </nav>
      </div>
    </header>

    <main class="container">
      <section class="section card">
        <h2 class="listTitle"><%= mode === 'create' ? 'Create Post' : 'Edit Post' %></h2>

        <% if (error) { %>
          <div class="notice"><%= error %></div>
          <div style="height:12px"></div>
        <% } %>

        <form id="postForm" method="POST" enctype="multipart/form-data"
          action="<%= mode === 'create' ? '/admin/posts/create' : ('/admin/posts/' + post.id + '/update') %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <div class="grid2">
            <div>
              <label class="muted">Type</label>
              <select name="type" required
                style="width:100%;margin-top:6px;padding:10px 12px;border-radius:12px;border:1px solid rgba(255,255,255,0.12);background:rgba(0,0,0,0.25);color:var(--text);">
                <option value="" <%= !post ? 'selected' : '' %>>Choose…</option>
                <option value="BLOG" <%= post && post.type === 'BLOG' ? 'selected' : '' %>>Blog</option>
                <option value="LETTER" <%= post && post.type === 'LETTER' ? 'selected' : '' %>>Letter</option>
              </select>
              <div class="muted" style="margin-top:6px;font-size:12px;">Required</div>
            </div>

            <div>
              <label class="muted">Post date</label>
              <input name="postDate" type="date" required
                value="<%= post ? new Date(post.postDate).toISOString().slice(0,10) : '' %>"
                style="width:100%;margin-top:6px;padding:10px 12px;border-radius:12px;border:1px solid rgba(255,255,255,0.12);background:rgba(0,0,0,0.25);color:var(--text);" />
              <div class="muted" style="margin-top:6px;font-size:12px;">Required</div>
            </div>

            <div style="grid-column:1/-1;">
              <label class="muted">Title</label>
              <input name="title" type="text" required value="<%= post ? post.title : '' %>"
                style="width:100%;margin-top:6px;padding:10px 12px;border-radius:12px;border:1px solid rgba(255,255,255,0.12);background:rgba(0,0,0,0.25);color:var(--text);" />
              <div class="muted" style="margin-top:6px;font-size:12px;">Required</div>
            </div>

            <div>
              <label class="muted">Content mode</label>
              <select id="contentMode" name="contentMode" required
                style="width:100%;margin-top:6px;padding:10px 12px;border-radius:12px;border:1px solid rgba(255,255,255,0.12);background:rgba(0,0,0,0.25);color:var(--text);">
                <option value="RICH" <%= post && post.contentType === 'PDF' ? '' : 'selected' %>>Editor</option>
                <option value="PDF" <%= post && post.contentType === 'PDF' ? 'selected' : '' %>>PDF Upload</option>
              </select>
              <div class="muted" style="margin-top:6px;font-size:12px;">Required</div>
            </div>

            <div>
              <label class="muted">Regenerate URL slug</label>
              <div class="muted" style="font-size:12px;margin-top:6px;">
                <input type="checkbox" name="regenerateSlug" <%= mode === 'create' ? 'checked' : '' %> />
                If checked, the URL updates when you change the title.
              </div>
            </div>
          </div>

          <div style="height:14px"></div>

          <div id="editorWrap">
            <label class="muted">Post content</label>
            <input id="contentHtml" name="contentHtml" type="hidden" value="<%= post ? post.contentHtml : '' %>"/>
            <div id="quillEditor" style="margin-top:8px;"></div>
            <div class="muted" style="margin-top:8px;font-size:12px;">Required in Editor mode</div>
          </div>

          <div id="pdfWrap" style="display:none;">
            <label class="muted">PDF file</label>
            <input name="pdfFile" type="file" accept="application/pdf"
              style="width:100%;margin-top:8px;padding:10px 12px;border-radius:12px;border:1px solid rgba(255,255,255,0.12);background:rgba(0,0,0,0.25);color:var(--text);" />
            <div class="muted" style="margin-top:8px;font-size:12px;">
              Required in PDF mode. If you upload a PDF, the site will extract text so it displays like a normal post, and it will also keep the original PDF link.
            </div>
          </div>

          <div style="height:16px"></div>

          <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
            <button class="btn primary" type="submit">Save</button>
            <a class="btn" href="/admin/posts">Cancel</a>
          </div>
        </form>
      </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>
    <script src="/public/js/admin.js"></script>
    <script src="/public/js/quill-init.js"></script>
  </body>
</html>

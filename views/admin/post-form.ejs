<!doctype html>
<html lang="en" data-title-key="<%= mode === 'create' ? 'createPost' : 'editPost' %>">
  <head>
<%- include("../partials/admin-head") %>
    <title><%= mode === "create" ? "Create Post" : "Edit Post" %> | The Augustine Journal</title>
    <link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet" integrity="sha384-cPa8kzsYWhqpAfWOLWYIw3V0BhPi/m3lrd8tBTPxr2NrYCHRVZ7xy1cEoRGOM/03" crossorigin="anonymous">
    <style>
      .ql-toolbar.ql-snow, .ql-container.ql-snow {
        border-color: var(--border);
        background: rgba(0,0,0,0.12);
        color: var(--text);
      }
      .ql-container { min-height: 220px; border-radius: 0 0 var(--radius) var(--radius); }
      .ql-toolbar { border-radius: var(--radius) var(--radius) 0 0; }
      .ql-editor { color: var(--text); font-family: var(--font-serif); line-height: 1.7; }
      .ql-snow .ql-stroke { stroke: var(--muted); }
      .ql-snow .ql-fill { fill: var(--muted); }
      .ql-snow .ql-picker-label { color: var(--muted); }
      .ql-snow .ql-picker-options { background: #1a1a22; border-color: var(--border); }
      .ql-snow .ql-picker-item { color: var(--text); }
      #pdfEditorWrap { display: none; margin-top: 16px; }
      #pdfEditorWrap.visible { display: block; }
      /* Apple-style toggle switch */
      .toggle-switch {
        position: relative;
        display: inline-block;
        width: 44px;
        height: 24px;
        flex-shrink: 0;
        cursor: pointer;
      }
      .toggle-switch input[type="checkbox"] {
        opacity: 0;
        width: 0;
        height: 0;
        position: absolute;
      }
      .toggle-slider {
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0.15);
        border-radius: 12px;
        transition: background 0.3s ease;
      }
      .toggle-slider::before {
        content: "";
        position: absolute;
        width: 18px;
        height: 18px;
        left: 3px;
        top: 3px;
        background: #fff;
        border-radius: 50%;
        transition: transform 0.3s ease;
      }
      .toggle-switch input[type="checkbox"]:checked + .toggle-slider {
        background: var(--purple);
      }
      .toggle-switch input[type="checkbox"]:checked + .toggle-slider::before {
        transform: translateX(20px);
      }
      .pdf-extract-status {
        font-family: var(--font-sans);
        font-size: 12px;
        color: var(--muted);
        margin-top: 8px;
        letter-spacing: 0.2px;
      }
      .pdf-extract-status.error { color: #e07070; }
    </style>
  </head>
  <body>
    <%- include("../partials/admin-nav", { current: "posts" }) %>
<%
  const p = post || {};
  const dateValue = (() => {
    if (!p.postDate) return new Date().toISOString().slice(0, 10);
    if (typeof p.postDate === "string" && /^\d{4}-\d{2}-\d{2}$/.test(p.postDate)) return p.postDate;
    const d = new Date(p.postDate);
    return Number.isNaN(d.getTime()) ? "" : d.toISOString().slice(0, 10);
  })();
  const isPdf = p.contentType === "PDF";
%>
    <main class="container">
      <section class="section card">
        <h2 class="listTitle" data-i18n="<%= mode === 'create' ? 'createPost' : 'editPost' %>"><%= mode === "create" ? "Create Post" : "Edit Post" %></h2>

        <% if (error) { %>
          <div class="alert-error" role="alert"<% if (typeof errorKey !== 'undefined' && errorKey) { %> data-i18n="<%= errorKey %>"<% } %>><%= error %></div>
        <% } %>

        <form id="postForm" method="POST" enctype="multipart/form-data" class="notranslate" translate="no"
          action="<%= mode === 'create' ? '/admin/posts/create' : '/admin/posts/' + encodeURIComponent(p.id) + '/update' %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" id="pdfPathInput" name="pdfPath" value="<%= p.pdfPath || '' %>" />

          <div class="grid2">
            <div>
              <label class="form-label" for="postType" data-i18n="type">Type</label>
              <select id="postType" name="type" required class="form-input">
                <option value="" <%= !p.type ? "selected" : "" %> data-i18n="choose">Choose&hellip;</option>
                <option value="BLOG" <%= p.type === "BLOG" ? "selected" : "" %> data-i18n="blog">Blog</option>
                <option value="ESSAY" <%= p.type === "ESSAY" ? "selected" : "" %> data-i18n="essay">Essay</option>
                <option value="LETTER" <%= p.type === "LETTER" ? "selected" : "" %> data-i18n="letter">Letter</option>
              </select>
              <div class="form-hint" data-i18n="required">Required</div>
            </div>

            <div>
              <label class="form-label" for="postDate" data-i18n="postDate">Post date</label>
              <input id="postDate" name="postDate" type="date" required class="form-input" value="<%= dateValue %>"<% if (mode === 'create' && !error) { %> data-default-today<% } %> />
              <div class="form-hint" data-i18n="required">Required</div>
            </div>

            <div style="grid-column:1/-1;">
              <label class="form-label" for="postTitle" data-i18n="title">Title</label>
              <input id="postTitle" name="title" type="text" required maxlength="300" class="form-input" value="<%= p.title || '' %>" />
              <div class="form-hint" data-i18n="required">Required</div>

              <div class="auto-translate-toggle" style="display:flex;align-items:center;gap:10px;margin-top:12px;">
                <label class="toggle-switch" for="autoTranslateTitle">
                  <input type="checkbox" id="autoTranslateTitle" name="autoTranslateTitle" value="true"
                    <%= p.autoTranslateTitle !== false ? "checked" : "" %> />
                  <span class="toggle-slider"></span>
                </label>
                <label for="autoTranslateTitle" style="font-family:var(--font-sans);font-size:13px;color:var(--muted);cursor:pointer;" data-i18n="autoTranslateTitle">Auto Translation for Title</label>
              </div>
            </div>

            <div>
              <label class="form-label" for="contentMode" data-i18n="contentMode">Content mode</label>
              <select id="contentMode" name="contentMode" required class="form-input">
                <option value="RICH" <%= isPdf ? "" : "selected" %> data-i18n="editor">Editor</option>
                <option value="PDF" <%= isPdf ? "selected" : "" %> data-i18n="pdfUpload">PDF Upload</option>
              </select>
              <div class="form-hint" data-i18n="required">Required</div>
            </div>

            <div>
              <span class="form-label" data-i18n="regenSlug">Regenerate URL slug</span>
              <div style="margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-family:var(--font-sans);font-size:13px;color:var(--muted);">
                  <input type="checkbox" name="regenerateSlug" <%= mode === "create" ? "checked disabled" : "" %> />
                  <span data-i18n="updateUrlOnTitleChange">Update URL when title changes</span>
                </label>
              </div>
            </div>
          </div>

          <hr class="divider" />

          <div id="editorWrap">
            <span class="form-label" data-i18n="postContent">Post content</span>
            <input id="contentHtml" name="contentHtml" type="hidden" value="<%= p.contentHtml || '' %>" />
            <div id="quillEditor" style="margin-top:6px;"></div>
            <div class="form-hint" data-i18n="requiredEditorMode">Required in Editor mode</div>
          </div>

          <div id="pdfWrap" style="display:none;">
            <label class="form-label" for="pdfFileInput" data-i18n="pdfFile">PDF file</label>
            <input id="pdfFileInput" name="pdfFile" type="file" accept="application/pdf,.pdf" class="form-input" style="margin-top:6px;" />
            <div class="form-hint" data-i18n="pdfUploadHint">
              Upload a PDF. Text will be extracted and placed into an editor below for formatting.
            </div>
            <div id="pdfExtractStatus" class="pdf-extract-status" role="status"></div>

            <div id="pdfEditorWrap">
              <span class="form-label" style="margin-top:16px;" data-i18n="extractedContent">Extracted content (edit below)</span>
              <div id="pdfQuillEditor" style="margin-top:6px;"></div>
              <div class="form-hint" data-i18n="formatExtractedText">Format the extracted text using the toolbar above. This will be saved as the post content.</div>
            </div>
          </div>

          <hr class="divider" />

          <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
            <button class="btn primary" type="submit" data-i18n="save">Save</button>
            <a class="btn" href="/admin/posts" data-i18n="cancel">Cancel</a>
          </div>
        </form>
      </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js" integrity="sha384-QUJ+ckWz1M+a7w0UfG1sEn4pPrbQwSxGm/1TIPyioqXBrwuT9l4f9gdHWLDLbVWI" crossorigin="anonymous"></script>
    <script src="/public/js/i18n.js"></script>
    <script nonce="<%= cspNonce %>">
      /* A new post defaults to today's date where the author is, not on the server. */
      (function () {
        var input = document.querySelector("input[data-default-today]");
        if (!input) return;
        var now = new Date();
        var local = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
        if (input.value === new Date().toISOString().slice(0, 10)) input.value = local;
      })();
    </script>
    <script src="/public/js/admin.js"></script>
    <script src="/public/js/quill-init.js"></script>
  </body>
</html>

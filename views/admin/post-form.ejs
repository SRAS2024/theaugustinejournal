<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title><%= mode === "create" ? "Create Post" : "Edit Post" %> | The Augustine Journal</title>
    <link rel="icon" href="/public/icons/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/public/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/public/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/public/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/public/css/styles.css" />
    <link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet">
    <style>
      .ql-toolbar.ql-snow, .ql-container.ql-snow {
        border-color: var(--border);
        background: rgba(0,0,0,0.12);
        color: var(--text);
      }
      .ql-container { min-height: 220px; border-radius: 0 0 var(--radius) var(--radius); }
      .ql-toolbar { border-radius: var(--radius) var(--radius) 0 0; }
      .ql-editor { color: var(--text); font-family: var(--font-serif); line-height: 1.7; }
      .ql-snow .ql-stroke { stroke: var(--muted); }
      .ql-snow .ql-fill { fill: var(--muted); }
      .ql-snow .ql-picker-label { color: var(--muted); }
      .ql-snow .ql-picker-options { background: #1a1a22; border-color: var(--border); }
      .ql-snow .ql-picker-item { color: var(--text); }
      #pdfEditorWrap { display: none; margin-top: 16px; }
      #pdfEditorWrap.visible { display: block; }
      .pdf-extract-status {
        font-family: var(--font-sans);
        font-size: 12px;
        color: var(--muted);
        margin-top: 8px;
        letter-spacing: 0.2px;
      }
      .pdf-extract-status.error { color: #e07070; }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="container header-inner">
        <h1 class="brand"><a href="/admin/dashboard" style="color:inherit;text-decoration:none;">The Augustine Journal</a></h1>
        <nav class="admin-nav">
          <a href="/">View Site</a>
          <a href="/admin/dashboard">Dashboard</a>
          <a href="/admin/posts" class="active">Posts</a>
          <a href="/admin/settings">Site Settings</a>
          <form method="POST" action="/admin/logout" style="display:inline;margin:0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit">Log out</button>
          </form>
        </nav>
      </div>
    </header>

    <main class="container">
      <section class="section card">
        <h2 class="listTitle"><%= mode === "create" ? "Create Post" : "Edit Post" %></h2>

        <% if (error) { %>
          <div class="alert-error"><%= error %></div>
        <% } %>

        <form id="postForm" method="POST" enctype="multipart/form-data"
          action="<%= mode === "create" ? "/admin/posts/create?_csrf=" + encodeURIComponent(csrfToken) : "/admin/posts/" + post.id + "/update?_csrf=" + encodeURIComponent(csrfToken) %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" id="pdfPathInput" name="pdfPath" value="<%= post && post.pdfPath ? post.pdfPath : "" %>" />

          <div class="grid2">
            <div>
              <label class="form-label">Type</label>
              <select name="type" required class="form-input">
                <option value="" <%= !post ? "selected" : "" %>>Choose&hellip;</option>
                <option value="BLOG" <%= post && post.type === "BLOG" ? "selected" : "" %>>Blog</option>
                <option value="ESSAY" <%= post && post.type === "ESSAY" ? "selected" : "" %>>Essay</option>
                <option value="LETTER" <%= post && post.type === "LETTER" ? "selected" : "" %>>Letter</option>
              </select>
              <div class="form-hint">Required</div>
            </div>

            <div>
              <label class="form-label">Post date</label>
              <input name="postDate" type="date" required class="form-input"
                value="<%= post && post.postDate ? new Date(post.postDate).toISOString().slice(0,10) : new Date().toISOString().slice(0,10) %>" />
              <div class="form-hint">Required</div>
            </div>

            <div style="grid-column:1/-1;">
              <label class="form-label">Title</label>
              <input name="title" type="text" required class="form-input" value="<%= post ? post.title : "" %>" />
              <div class="form-hint">Required</div>
            </div>

            <div>
              <label class="form-label">Content mode</label>
              <select id="contentMode" name="contentMode" required class="form-input">
                <option value="RICH" <%= post && post.contentType === "PDF" ? "" : "selected" %>>Editor</option>
                <option value="PDF" <%= post && post.contentType === "PDF" ? "selected" : "" %>>PDF Upload</option>
              </select>
              <div class="form-hint">Required</div>
            </div>

            <div>
              <label class="form-label">Regenerate URL slug</label>
              <div style="margin-top:8px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-family:var(--font-sans);font-size:13px;color:var(--muted);">
                  <input type="checkbox" name="regenerateSlug" <%= mode === "create" ? "checked" : "" %> />
                  Update URL when title changes
                </label>
              </div>
            </div>
          </div>

          <hr class="divider" />

          <div id="editorWrap">
            <label class="form-label">Post content</label>
            <input id="contentHtml" name="contentHtml" type="hidden" value="<%= post ? post.contentHtml : "" %>" />
            <div id="quillEditor" style="margin-top:6px;"></div>
            <div class="form-hint">Required in Editor mode</div>
          </div>

          <div id="pdfWrap" style="display:none;">
            <label class="form-label">PDF file</label>
            <input id="pdfFileInput" name="pdfFile" type="file" accept="application/pdf" class="form-input" style="margin-top:6px;" />
            <div class="form-hint">
              Upload a PDF. Text will be extracted and placed into an editor below for formatting.
            </div>
            <div id="pdfExtractStatus" class="pdf-extract-status"></div>

            <div id="pdfEditorWrap">
              <label class="form-label" style="margin-top:16px;">Extracted content (edit below)</label>
              <div id="pdfQuillEditor" style="margin-top:6px;"></div>
              <div class="form-hint">Format the extracted text using the toolbar above. This will be saved as the post content.</div>
            </div>
          </div>

          <hr class="divider" />

          <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
            <button class="btn primary" type="submit">Save</button>
            <a class="btn" href="/admin/posts">Cancel</a>
          </div>
        </form>
      </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>
    <script src="/public/js/admin.js"></script>
    <script src="/public/js/quill-init.js"></script>
  </body>
</html>

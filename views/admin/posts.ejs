<!doctype html>
<html lang="<%= typeof detectedLang !== 'undefined' ? detectedLang : 'en' %>" translate="yes">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="detected-lang" content="<%= typeof detectedLang !== 'undefined' ? detectedLang : 'en' %>" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <title>Posts | The Augustine Journal</title>
    <link rel="icon" href="/public/icons/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/public/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/public/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/public/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/public/css/styles.css" />
  </head>
  <body>
    <header class="topbar">
      <div class="container header-inner">
        <h1 class="brand notranslate"><a href="/admin/dashboard" style="color:inherit;text-decoration:none;">The Augustine Journal</a></h1>
        <nav class="admin-nav">
          <a href="/" data-i18n="viewSite">View Site</a>
          <a href="/admin/dashboard" data-i18n="dashboard">Dashboard</a>
          <a href="/admin/posts" class="active" data-i18n="posts">Posts</a>
          <a href="/admin/settings" data-i18n="siteSettings">Site Settings</a>
          <form method="POST" action="/admin/logout" style="display:inline;margin:0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" data-i18n="logOut">Log out</button>
          </form>
        </nav>
      </div>
    </header>

    <main class="container">
      <section class="section card">
        <h2 class="listTitle" data-i18n="posts">Posts</h2>

        <% if (saved) { %>
          <div class="alert-success" data-i18n="changesSaved">Changes saved successfully.</div>
        <% } %>

        <div style="display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-bottom:18px;">
          <a class="btn <%= filter === 'ALL' ? 'primary' : '' %>" href="/admin/posts?type=ALL" data-i18n="all">All</a>
          <a class="btn <%= filter === 'BLOG' ? 'primary' : '' %>" href="/admin/posts?type=BLOG" data-i18n="blog">Blog</a>
          <a class="btn <%= filter === 'ESSAY' ? 'primary' : '' %>" href="/admin/posts?type=ESSAY" data-i18n="essays">Essays</a>
          <a class="btn <%= filter === 'LETTER' ? 'primary' : '' %>" href="/admin/posts?type=LETTER" data-i18n="letters">Letters</a>
          <a class="btn primary" href="/admin/posts/new" data-i18n="createPost">Create Post</a>
        </div>

        <% if (!posts || posts.length === 0) { %>
          <div class="empty-state" data-i18n="noPostsYet">No posts yet.</div>
        <% } %>

        <div style="display:grid;gap:8px;">
          <% (posts || []).forEach(function(p) { %>
            <div class="postRow">
              <div>
                <div class="title" style="margin:0;">
                  <a href="/post/<%= p.slug %>" target="_blank" rel="noopener noreferrer"><%= p.title %></a>
                  <span style="font-size:11px;color:rgba(138,138,153,0.6);font-family:var(--font-sans);font-weight:400;margin-left:8px;"><%= p.viewCount || 0 %> <%= (p.viewCount || 0) === 1 ? 'view' : 'views' %></span>
                </div>
                <div class="muted" style="margin-top:6px;font-size:12px;">
                  <span data-i18n="<%= p.type === 'BLOG' ? 'blog' : (p.type === 'ESSAY' ? 'essay' : 'letter') %>"><%= p.type === 'BLOG' ? 'Blog' : (p.type === 'ESSAY' ? 'Essay' : 'Letter') %></span> &middot;
                  <%= new Date(p.postDate).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %> &middot;
                  <span data-i18n="<%= p.contentType === 'PDF' ? '' : 'editor' %>"><%= p.contentType === 'PDF' ? 'PDF' : 'Editor' %></span>
                </div>
              </div>

              <div style="display:flex;gap:8px;align-items:center;flex-shrink:0;">
                <a class="btn" href="/admin/posts/<%= p.id %>/edit" data-i18n="edit">Edit</a>
                <button class="btn danger delete-post-btn" type="button" data-i18n="delete_"
                  data-post-id="<%= p.id %>"
                  data-post-title="<%= p.title %>"
                >Delete</button>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    </main>

    <!-- Delete Confirmation Modal -->
    <div class="modal-overlay" id="deleteConfirmModal">
      <div class="modal-box">
        <p class="modal-message">Are you sure you want to delete this post?</p>
        <p class="modal-post-name" id="deletePostName"></p>
        <div class="modal-actions">
          <button class="btn" type="button" id="cancelDeleteBtn">Cancel</button>
          <button class="btn danger" type="button" id="confirmDeleteBtn">Delete</button>
        </div>
      </div>
    </div>

    <!-- Password Confirmation Modal -->
    <div class="modal-overlay" id="passwordModal">
      <div class="modal-box">
        <p class="modal-message">Please enter administrative password</p>
        <input type="password" class="form-input" id="adminPasswordInput" autocomplete="off" />
        <p class="modal-error" id="passwordError">Incorrect password.</p>
        <div class="modal-actions">
          <button class="btn" type="button" id="cancelPasswordBtn">Cancel</button>
          <button class="btn danger" type="button" id="confirmPasswordBtn">Confirm</button>
        </div>
      </div>
    </div>

    <script>
      (function() {
        var deletePostId = null;
        var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

        var deleteConfirmModal = document.getElementById('deleteConfirmModal');
        var passwordModal = document.getElementById('passwordModal');
        var deletePostName = document.getElementById('deletePostName');
        var passwordInput = document.getElementById('adminPasswordInput');
        var passwordError = document.getElementById('passwordError');
        var confirmPasswordBtn = document.getElementById('confirmPasswordBtn');

        // Attach click handlers to all delete buttons via delegation
        document.querySelectorAll('.delete-post-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            deletePostId = btn.getAttribute('data-post-id');
            deletePostName.textContent = btn.getAttribute('data-post-title');
            deleteConfirmModal.classList.add('active');
          });
        });

        // First modal: Cancel
        document.getElementById('cancelDeleteBtn').addEventListener('click', function() {
          deleteConfirmModal.classList.remove('active');
          deletePostId = null;
        });

        // First modal: Delete → open password modal
        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
          deleteConfirmModal.classList.remove('active');
          passwordInput.value = '';
          passwordError.style.display = 'none';
          passwordModal.classList.add('active');
          passwordInput.focus();
        });

        // Second modal: Cancel
        document.getElementById('cancelPasswordBtn').addEventListener('click', function() {
          passwordModal.classList.remove('active');
          deletePostId = null;
        });

        // Second modal: Confirm with password
        function submitPassword() {
          var password = passwordInput.value;
          if (!password) {
            passwordError.style.display = 'block';
            return;
          }
          confirmPasswordBtn.disabled = true;
          confirmPasswordBtn.textContent = '...';

          fetch('/admin/posts/' + encodeURIComponent(deletePostId) + '/delete', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'x-csrf-token': csrfToken
            },
            body: JSON.stringify({ password: password })
          }).then(function(res) {
            return res.json();
          }).then(function(data) {
            if (data.success) {
              window.location.href = '/admin/posts?saved=true';
            } else {
              passwordError.style.display = 'block';
              confirmPasswordBtn.disabled = false;
              confirmPasswordBtn.textContent = 'Confirm';
            }
          }).catch(function() {
            passwordError.style.display = 'block';
            confirmPasswordBtn.disabled = false;
            confirmPasswordBtn.textContent = 'Confirm';
          });
        }

        confirmPasswordBtn.addEventListener('click', submitPassword);
        passwordInput.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') submitPassword();
        });

        // Close modals when clicking the overlay background
        deleteConfirmModal.addEventListener('click', function(e) {
          if (e.target === deleteConfirmModal) {
            deleteConfirmModal.classList.remove('active');
            deletePostId = null;
          }
        });
        passwordModal.addEventListener('click', function(e) {
          if (e.target === passwordModal) {
            passwordModal.classList.remove('active');
            deletePostId = null;
          }
        });
      })();
    </script>

    <script src="/public/js/i18n.js"></script>
  </body>
</html>

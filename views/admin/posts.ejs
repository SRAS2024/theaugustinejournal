<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Posts | The Augustine Journal</title>
    <link rel="icon" href="/public/icons/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/public/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/public/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/public/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/public/css/styles.css" />
  </head>
  <body>
    <header class="topbar">
      <div class="container header-inner">
        <h1 class="brand"><a href="/admin/dashboard" style="color:inherit;text-decoration:none;">The Augustine Journal</a></h1>
        <nav class="admin-nav">
          <a href="/">View Site</a>
          <a href="/admin/dashboard">Dashboard</a>
          <a href="/admin/posts" class="active">Posts</a>
          <a href="/admin/settings">Site Settings</a>
          <form method="POST" action="/admin/logout" style="display:inline;margin:0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit">Log out</button>
          </form>
        </nav>
      </div>
    </header>

    <main class="container">
      <section class="section card">
        <h2 class="listTitle">Posts</h2>

        <% if (saved) { %>
          <div class="alert-success">Changes saved successfully.</div>
        <% } %>

        <div style="display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-bottom:18px;">
          <a class="btn <%= filter === 'ALL' ? 'primary' : '' %>" href="/admin/posts?type=ALL">All</a>
          <a class="btn <%= filter === 'BLOG' ? 'primary' : '' %>" href="/admin/posts?type=BLOG">Blog</a>
          <a class="btn <%= filter === 'ESSAY' ? 'primary' : '' %>" href="/admin/posts?type=ESSAY">Essays</a>
          <a class="btn <%= filter === 'LETTER' ? 'primary' : '' %>" href="/admin/posts?type=LETTER">Letters</a>
          <a class="btn primary" href="/admin/posts/new">Create Post</a>
        </div>

        <% if (!posts || posts.length === 0) { %>
          <div class="empty-state">No posts yet.</div>
        <% } %>

        <div style="display:grid;gap:8px;">
          <% (posts || []).forEach(function(p) { %>
            <div class="postRow">
              <div>
                <div class="title" style="margin:0;">
                  <a href="/post/<%= p.slug %>" target="_blank" rel="noopener noreferrer"><%= p.title %></a>
                </div>
                <div class="muted" style="margin-top:6px;font-size:12px;">
                  <%= p.type === 'BLOG' ? 'Blog' : (p.type === 'ESSAY' ? 'Essay' : 'Letter') %> ·
                  <%= new Date(p.postDate).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %> ·
                  <%= p.contentType === 'PDF' ? 'PDF' : 'Editor' %>
                </div>
              </div>

              <div style="display:flex;gap:8px;align-items:center;flex-shrink:0;">
                <a class="btn" href="/admin/posts/<%= p.id %>/edit">Edit</a>
                <form method="POST" action="/admin/posts/<%= p.id %>/delete" onsubmit="return confirm('Delete this post?');" style="margin:0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn danger" type="submit">Delete</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    </main>
  </body>
</html>

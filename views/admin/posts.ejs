<!doctype html>
<html lang="en" data-title-key="posts">
  <head>
<%- include("../partials/admin-head") %>
    <title>Posts | The Augustine Journal</title>
  </head>
  <body>
    <%- include("../partials/admin-nav", { current: "posts" }) %>

    <main class="container">
      <section class="section card">
        <h2 class="listTitle" data-i18n="posts">Posts</h2>

        <% if (saved) { %>
          <div class="alert-success" role="status" data-i18n="changesSaved">Changes saved successfully.</div>
        <% } %>

        <div style="display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-bottom:18px;">
          <a class="btn <%= filter === 'ALL' ? 'primary' : '' %>" href="/admin/posts?type=ALL" data-i18n="all">All</a>
          <a class="btn <%= filter === 'BLOG' ? 'primary' : '' %>" href="/admin/posts?type=BLOG" data-i18n="blog">Blog</a>
          <a class="btn <%= filter === 'ESSAY' ? 'primary' : '' %>" href="/admin/posts?type=ESSAY" data-i18n="essays">Essays</a>
          <a class="btn <%= filter === 'LETTER' ? 'primary' : '' %>" href="/admin/posts?type=LETTER" data-i18n="letters">Letters</a>
          <a class="btn primary" href="/admin/posts/new" data-i18n="createPost">Create Post</a>
        </div>

        <% if (!posts || posts.length === 0) { %>
          <div class="empty-state" data-i18n="noPostsYet">No posts yet.</div>
        <% } %>

        <div style="display:grid;gap:8px;">
          <% (posts || []).forEach(function(p) { %>
            <% const views = p.viewCount || 0; const shares = p.shareCount || 0; %>
            <div class="postRow">
              <div>
                <div class="title" style="margin:0;">
                  <a href="/post/<%= encodeURIComponent(p.slug) %>" target="_blank" rel="noopener noreferrer" translate="no"><%= p.title %></a>
                  <span style="font-size:11px;color:rgba(138,138,153,0.85);font-family:var(--font-sans);font-weight:400;margin-left:8px;"><span data-i18n-count="viewsCount" data-count="<%= views %>"><%= views %> <%= views === 1 ? 'view' : 'views' %></span> &middot; <span data-i18n-count="sharesCount" data-count="<%= shares %>"><%= shares %> <%= shares === 1 ? 'share' : 'shares' %></span></span>
                </div>
                <div class="muted" style="margin-top:6px;font-size:12px;">
                  <span data-i18n="<%= p.type === 'BLOG' ? 'blog' : (p.type === 'ESSAY' ? 'essay' : 'letter') %>"><%= p.type === 'BLOG' ? 'Blog' : (p.type === 'ESSAY' ? 'Essay' : 'Letter') %></span> &middot;
                  <time datetime="<%= isoDate(p.postDate) %>" data-i18n-date><%= formatDate(p.postDate) %></time> &middot;
                  <span data-i18n="<%= p.contentType === 'PDF' ? 'pdf' : 'editor' %>"><%= p.contentType === 'PDF' ? 'PDF' : 'Editor' %></span>
                </div>
              </div>

              <div style="display:flex;gap:8px;align-items:center;flex-shrink:0;">
                <a class="btn" href="/admin/posts/<%= encodeURIComponent(p.id) %>/edit" data-i18n="edit">Edit</a>
                <button class="btn danger" type="button" data-i18n="delete_"
                  data-confirm-url="/admin/posts/<%= encodeURIComponent(p.id) %>/delete"
                  data-confirm-key="deletePostQuestion"
                  data-confirm-action="delete_"
                  data-confirm-item="<%= p.title %>"
                  data-confirm-redirect="/admin/posts?saved=true"
                >Delete</button>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    </main>

    <%- include("../partials/admin-confirm-modals") %>

    <script src="/public/js/i18n.js"></script>
    <script src="/public/js/admin-confirm.js"></script>
  </body>
</html>

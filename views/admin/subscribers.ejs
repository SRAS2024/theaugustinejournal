<!doctype html>
<html lang="en" data-title-key="subscribers">
  <head>
<%- include("../partials/admin-head") %>
    <title>Subscribers | The Augustine Journal</title>
  </head>
  <body>
    <%- include("../partials/admin-nav", { current: "" }) %>

    <main class="container">
      <section class="section card">
        <h2 class="listTitle" data-i18n="subscribers">Subscribers</h2>

        <% if (subscribers.length === 0) { %>
          <div class="empty-state" data-i18n="noSubscribers">No subscribers yet.</div>
        <% } else { %>
          <div style="margin-bottom:16px;text-align:center;">
            <span class="muted" data-i18n-count="subscriberCount" data-count="<%= subscribers.length %>"><%= subscribers.length %> <%= subscribers.length === 1 ? 'subscriber' : 'subscribers' %></span>
          </div>
          <% subscribers.forEach(function(sub) { %>
            <div class="postRow" style="align-items:center;">
              <div style="flex:1;min-width:0;">
                <div style="font-family:var(--font-sans);font-size:14px;font-weight:400;" translate="no"><%= sub.email %></div>
                <div style="display:flex;gap:12px;font-family:var(--font-sans);font-size:11px;color:var(--muted);margin-top:4px;">
                  <span translate="no"><%= String(sub.language || 'en').toUpperCase() %></span>
                  <time datetime="<%= new Date(sub.createdAt).toISOString() %>" data-i18n-date="short"><%= formatDate(sub.createdAt, { year: 'numeric', month: 'short', day: 'numeric' }) %></time>
                </div>
              </div>
              <div style="flex-shrink:0;">
                <button class="btn danger" type="button" data-i18n="unsubscribe"
                  data-confirm-url="/admin/subscribers/<%= encodeURIComponent(sub.id) %>/delete"
                  data-confirm-key="removeSubscriberConfirm"
                  data-confirm-action="confirm"
                  data-var-email="<%= sub.email %>"
                  data-confirm-redirect="/admin/subscribers"
                >Unsubscribe</button>
              </div>
            </div>
          <% }); %>
        <% } %>

        <div style="display:flex;justify-content:center;margin-top:20px;">
          <a class="btn" href="/admin/dashboard" data-i18n="dashboard">Dashboard</a>
        </div>
      </section>
    </main>

    <%- include("../partials/admin-confirm-modals") %>

    <script src="/public/js/i18n.js"></script>
    <script src="/public/js/admin-confirm.js"></script>
  </body>
</html>

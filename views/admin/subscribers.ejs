<!doctype html>
<html lang="<%= typeof detectedLang !== 'undefined' ? detectedLang : 'en' %>" translate="yes">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="detected-lang" content="<%= typeof detectedLang !== 'undefined' ? detectedLang : 'en' %>" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Subscribers | The Augustine Journal</title>
    <link rel="icon" href="/public/icons/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/public/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/public/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/public/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/public/css/styles.css" />
  </head>
  <body>
    <header class="topbar">
      <div class="container header-inner">
        <h1 class="brand notranslate"><a href="/admin/dashboard" style="color:inherit;text-decoration:none;">The Augustine Journal</a></h1>
        <nav class="admin-nav">
          <a href="/" data-i18n="viewSite">View Site</a>
          <a href="/admin/dashboard" data-i18n="dashboard">Dashboard</a>
          <a href="/admin/posts" data-i18n="posts">Posts</a>
          <a href="/admin/settings" data-i18n="siteSettings">Site Settings</a>
          <form method="POST" action="/admin/logout" style="display:inline;margin:0;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" data-i18n="logOut">Log out</button>
          </form>
        </nav>
      </div>
    </header>

    <main class="container">
      <section class="section card">
        <h2 class="listTitle" data-i18n="subscribers">Subscribers</h2>

        <% if (subscribers.length === 0) { %>
          <div class="empty-state" data-i18n="noSubscribers">No subscribers yet.</div>
        <% } else { %>
          <div style="margin-bottom:16px;text-align:center;">
            <span class="muted"><%= subscribers.length %> <span data-i18n="subscriberCount">subscriber(s)</span></span>
          </div>
          <% subscribers.forEach(function(sub) { %>
            <div class="postRow" style="flex-direction:column;gap:4px;">
              <div style="font-family:var(--font-sans);font-size:14px;font-weight:400;"><%= sub.email %></div>
              <div style="display:flex;gap:12px;font-family:var(--font-sans);font-size:11px;color:var(--muted);">
                <span><%= sub.language.toUpperCase() %></span>
                <span><%= new Date(sub.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
              </div>
            </div>
          <% }); %>
        <% } %>

        <div style="display:flex;justify-content:center;margin-top:20px;">
          <a class="btn" href="/admin/dashboard" data-i18n="dashboard">Dashboard</a>
        </div>
      </section>
    </main>

    <script src="/public/js/i18n.js"></script>
  </body>
</html>

<!doctype html>
<html lang="en" data-title-key="dashboard">
  <head>
<%- include("../partials/admin-head") %>
    <title>Welcome | The Augustine Journal</title>
  </head>
  <body>
    <header class="topbar">
      <div class="container header-inner">
        <h1 class="brand" translate="no">The Augustine Journal</h1>
        <div class="admin-nav">
          <span class="muted" data-i18n="adminSite">Administrative Site</span>
        </div>
      </div>
    </header>

    <main class="container" style="max-width:520px;">
      <section class="section card" style="text-align:center;">
        <h2 class="listTitle" style="margin-bottom:4px;" data-i18n-template="welcomeName" data-var-name="<%= adminName %>">Welcome, <%= adminName %>!</h2>
        <p class="muted" style="margin-bottom:24px;" data-i18n="loadingDashboard">Loading your dashboard&hellip;</p>

        <!-- Loading circle -->
        <div style="display:flex;justify-content:center;margin-bottom:24px;">
          <div id="loaderWrap" class="welcome-loader" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-i18n-aria-label="loadingDashboard" aria-label="Loading your dashboard">
            <!-- Charcoal circle background -->
            <svg width="80" height="80" viewBox="0 0 80 80" aria-hidden="true">
              <circle class="loader-track" cx="40" cy="40" r="35" />
            </svg>
            <!-- Dark purple loading arc -->
            <svg id="loaderArc" width="80" height="80" viewBox="0 0 80 80" style="transform:rotate(-90deg);" aria-hidden="true">
              <circle class="loader-arc" cx="40" cy="40" r="35" stroke-dasharray="220" stroke-dashoffset="220" />
            </svg>
          </div>
        </div>

        <!-- Loading bar -->
        <div class="welcome-bar" aria-hidden="true">
          <div id="loadBar"></div>
        </div>
      </section>
    </main>

    <script src="/public/js/i18n.js"></script>
    <script nonce="<%= cspNonce %>">
      (function() {
        var bar = document.getElementById('loadBar');
        var wrap = document.getElementById('loaderWrap');
        var arc = document.getElementById('loaderArc').querySelector('circle');
        var total = 3000;
        var start = performance.now();
        var circumference = 220;

        function tick(now) {
          var t = Math.min(1, (now - start) / total);
          bar.style.width = Math.round(t * 100) + '%';
          wrap.setAttribute('aria-valuenow', String(Math.round(t * 100)));
          arc.setAttribute('stroke-dashoffset', circumference - (t * circumference));
          if (t < 1) {
            requestAnimationFrame(tick);
          } else {
            window.location.href = '/admin/dashboard';
          }
        }
        requestAnimationFrame(tick);
        // requestAnimationFrame pauses in background tabs; continue regardless.
        setTimeout(function () { window.location.href = '/admin/dashboard'; }, total + 1500);
      })();
    </script>
  </body>
</html>

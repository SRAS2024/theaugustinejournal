      <div class="about" data-translate="content" data-original="${(settings?.aboutHtml || '').replace(/<[^>]+>/g, '').replace(/"/g,'&quot;')}">
        ${settings?.aboutHtml || ''}
      </div>

      <div class="latest">
        <span class="label" data-i18n="checkLatest">Check out our latest post</span>
        ${
          latest
            ? `<a href="/post/${latest.slug}"${latest.autoTranslateTitle === false ? ' class="notranslate"' : ''}${latest.autoTranslateTitle !== false ? ' data-translate="content"' : ''} data-original="${String(latest.title || "").replace(/"/g, "&quot;")}">${latest.title}</a>`
            : `<span class="muted" data-i18n="noPostsYet">No posts yet.</span>`
        }
      </div>

      <div class="subscribe-cta">
        <span class="subscribe-cta-label" data-i18n="stayUpdated">Stay updated on our latest posts?</span>
        <button class="btn subscribe-cta-btn" id="subscribeCta" type="button" data-i18n="subscribe">Subscribe</button>
      </div>
    </section>

    <!-- Subscribe popup modal -->
    <div class="modal-overlay" id="subscribeModal">
      <div class="modal-box subscribe-modal-box">
        <div class="subscribe-modal-title" data-i18n="subscribe">Subscribe</div>
        <div class="subscribe-modal-body" id="subscribeModalBody">
          <input type="email" class="form-input" id="subscribeEmail" data-i18n-placeholder="enterEmail" placeholder="Enter your email address" autocomplete="email" />
          <div class="subscribe-error" id="subscribeError"></div>
          <div class="modal-actions">
            <button class="btn" id="subscribeCancel" type="button" data-i18n="cancel">Cancel</button>
            <button class="btn primary" id="subscribeSubmit" type="button" data-i18n="subscribe">Subscribe</button>
          </div>
        </div>
        <div class="subscribe-success" id="subscribeSuccess" style="display:none;">
          <p data-i18n="subscribeThankYou">Thank you for subscribing to The Augustine Journal. You may unsubscribe at any time in your email.</p>
        </div>
      </div>
    </div>

    <script>
    (function() {
      var modal = document.getElementById('subscribeModal');
      var emailInput = document.getElementById('subscribeEmail');
      var errorEl = document.getElementById('subscribeError');
      var successEl = document.getElementById('subscribeSuccess');
      var bodyEl = document.getElementById('subscribeModalBody');
      var csrfMeta = document.querySelector('meta[name="csrf-token"]');
      var csrfToken = csrfMeta ? csrfMeta.getAttribute('content') : '';

      function openModal() {
        modal.classList.add('active');
        emailInput.value = '';
        errorEl.textContent = '';
        errorEl.style.display = 'none';
        successEl.style.display = 'none';
        bodyEl.style.display = '';
        setTimeout(function() { emailInput.focus(); }, 100);
      }

      function closeModal() {
        modal.classList.remove('active');
      }

      // Open from CTA button
      var ctaBtn = document.getElementById('subscribeCta');
      if (ctaBtn) ctaBtn.addEventListener('click', openModal);

      // Open from bell icon buttons
      document.addEventListener('click', function(e) {
        if (e.target.closest('.subscribe-bell-btn')) {
          e.preventDefault();
          openModal();
        }
      });

      // Cancel button
      document.getElementById('subscribeCancel').addEventListener('click', closeModal);

      // Click outside to close
      modal.addEventListener('click', function(e) {
        if (e.target === modal) closeModal();
      });

      // Submit
      document.getElementById('subscribeSubmit').addEventListener('click', function() {
        var email = emailInput.value.trim();
        var emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;

        if (!emailRegex.test(email)) {
          var lang = window.__i18nLang || 'en';
          var uiMap = window.__i18nUi || {};
          errorEl.textContent = (uiMap.invalidEmail && uiMap.invalidEmail[lang]) || 'Invalid email';
          errorEl.style.display = 'block';
          return;
        }

        var lang = window.__i18nLang || 'en';
        fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ email: email, language: lang })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.success) {
            bodyEl.style.display = 'none';
            successEl.style.display = '';
            var titleEl = document.querySelector('.subscribe-modal-title');
            if (titleEl) {
              var uiMap = window.__i18nUi || {};
              var lang = window.__i18nLang || 'en';
              titleEl.textContent = (uiMap.subscribed && uiMap.subscribed[lang]) || 'Subscribed!';
            }
          } else if (data.duplicate) {
            var uiMap = window.__i18nUi || {};
            var lang = window.__i18nLang || 'en';
            errorEl.textContent = (uiMap.alreadySubscribed && uiMap.alreadySubscribed[lang]) || 'Oops! You are already subscribed';
            errorEl.style.display = 'block';
          } else {
            errorEl.textContent = data.error || 'Something went wrong.';
            errorEl.style.display = 'block';
          }
        })
        .catch(function() {
          errorEl.textContent = 'Something went wrong.';
          errorEl.style.display = 'block';
        });
      });

      // Enter key submits
      emailInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') document.getElementById('subscribeSubmit').click();
      });
    })();
    </script>
  `;
%>

<%- include("layout", {
  title: "The Augustine Journal",
  active: "home",
  body,
  ogUrl: typeof canonical !== 'undefined' ? canonical : undefined,
  jsonLd: typeof jsonLd !== 'undefined' ? jsonLd : undefined
}) %>

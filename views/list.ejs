<%
  function formatDate(d){
    try{
      return new Date(d).toLocaleDateString(undefined, { year:"numeric", month:"long", day:"numeric" });
    }catch{
      return "";
    }
  }

  const rows = (posts || []).map(p => `
    <div class="postRow">
      <div>
        <p class="title"><a href="/post/${p.slug}">${p.title}</a></p>
      </div>
      <div class="date">${formatDate(p.postDate)}</div>
    </div>
  `).join("");

  const body = `
    <section class="section card">
      ${notices && notices.length ? `
        <div>
          ${notices.map(n => `<div class="notice" data-translate="content" data-original="${(n.message || "").replaceAll('"','&quot;')}">${n.message}</div>`).join("")}
        </div>
        <div style="height:14px"></div>
      ` : ``}

      <h2 class="listTitle">${pageTitle}</h2>

      ${rows || `<div class="muted" style="text-align:center">No posts yet.</div>`}
    </section>
  `;
%>

<%- include("layout", { title: `${pageTitle} | The Augustine Journal`, active: pageTitle === "Blog" ? "blog" : "letters", body }) %>

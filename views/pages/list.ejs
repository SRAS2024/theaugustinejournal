<section class="section card listPage">
  <h2 class="listTitle" data-i18n="<%= pageKey %>"><%= pageTitle %></h2>
  <%- include("../partials/ornament", { ornamentClass: "list-ornament" }) %>

  <% if (posts && posts.length) { %>
    <% posts.forEach(function (p) { %>
      <div class="postRow">
        <div>
          <p class="title">
            <% if (p.autoTranslateTitle === false) { %>
              <a href="/post/<%= encodeURIComponent(p.slug) %>" translate="no" lang="en"><%= p.title %></a>
            <% } else { %>
              <a href="/post/<%= encodeURIComponent(p.slug) %>" data-translate-key="post:<%= p.id %>:title" data-translate-kind="text"><%= p.title %></a>
            <% } %>
          </p>
          <time class="date" datetime="<%= isoDate(p.postDate) %>" data-i18n-date><%= formatDate(p.postDate) %></time>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="empty-state" data-i18n="noPostsYet">No posts yet.</div>
  <% } %>
</section>

<header class="topbar">
  <div class="container header-inner">
    <h1 class="brand"><a href="/" data-i18n="siteTitle"><%= siteTitle %></a></h1>

    <button class="hamburger" id="menuToggle" type="button" aria-label="Toggle navigation" data-i18n-aria-label="toggleNavigation" aria-controls="mainNav" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="nav" id="mainNav" aria-label="Primary navigation" data-i18n-aria-label="primaryNavigation">
      <a href="/" class="<%= active === 'home' ? 'active' : '' %>"<%- active === 'home' ? ' aria-current="page"' : '' %> data-i18n="home">Home</a>
      <a href="/blog" class="<%= active === 'blog' ? 'active' : '' %>"<%- active === 'blog' ? ' aria-current="page"' : '' %> data-i18n="blog">Blog</a>
      <a href="/essays" class="<%= active === 'essays' ? 'active' : '' %>"<%- active === 'essays' ? ' aria-current="page"' : '' %> data-i18n="essays">Essays</a>
      <a href="/letters" class="<%= active === 'letters' ? 'active' : '' %>"<%- active === 'letters' ? ' aria-current="page"' : '' %> data-i18n="letters">Letters</a>
    </nav>
  </div>
</header>

<script nonce="<%= cspNonce %>">
(function() {
  var btn = document.getElementById('menuToggle');
  var nav = document.getElementById('mainNav');
  if (btn && nav) {
    btn.addEventListener('click', function() {
      var open = !nav.classList.contains('open');
      btn.classList.toggle('open', open);
      nav.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }
})();
</script>

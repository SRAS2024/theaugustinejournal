<%#
  Site icons for every page: browser tabs and bookmarks (SVG first, PNGs and the
  .ico for browsers without SVG favicons), the iOS home screen, and installed
  apps (the manifest). The files come from scripts/favicon/build.sh; after a
  rebuild raise ICON_VERSION (and the ?v= in public/site.webmanifest) so
  browsers fetch them again.
%><% const ICON_VERSION = "2"; %>
    <link rel="icon" href="/public/icons/favicon.svg?v=<%= ICON_VERSION %>" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico?v=<%= ICON_VERSION %>" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="16x16" href="/public/icons/favicon-16.png?v=<%= ICON_VERSION %>" />
    <link rel="icon" type="image/png" sizes="32x32" href="/public/icons/favicon-32.png?v=<%= ICON_VERSION %>" />
    <link rel="icon" type="image/png" sizes="48x48" href="/public/icons/favicon-48.png?v=<%= ICON_VERSION %>" />
    <link rel="icon" type="image/png" sizes="96x96" href="/public/icons/favicon-96.png?v=<%= ICON_VERSION %>" />
    <link rel="icon" type="image/png" sizes="192x192" href="/public/icons/icon-192.png?v=<%= ICON_VERSION %>" />
    <link rel="apple-touch-icon" sizes="180x180" href="/public/icons/apple-touch-icon.png?v=<%= ICON_VERSION %>" />
    <link rel="manifest" href="/public/site.webmanifest?v=<%= ICON_VERSION %>" />

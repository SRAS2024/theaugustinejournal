<%
  function formatDate(d) {
    try {
      return new Date(d).toLocaleDateString(undefined, { year: "numeric", month: "long", day: "numeric" });
    } catch (e) {
      return "";
    }
  }

  function typeLabelFor(t) {
    if (t === "BLOG") return "Blog";
    if (t === "ESSAY") return "Essay";
    return "Letter";
  }

  const typeLabel = typeLabelFor(post.type);
  const typeKey = post.type === "BLOG" ? "blog" : post.type === "ESSAY" ? "essays" : "letters";

  const body = `
    <section class="postShell">
      <header class="postHeader">
        <h1 class="postTitle" data-translate="content" data-original="${String(post.title || "").replace(/"/g, "&quot;")}">${post.title}</h1>
        <div class="postMeta">
          <span class="postType" data-i18n="${typeKey}">${typeLabel}</span>
          <span class="postMetaSep">&mdash;</span>
          <time class="postDate">${formatDate(post.postDate)}</time>
        </div>
      </header>

      <div class="postRule"></div>

      <article class="postContent">
        ${post.contentHtml || ""}
      </article>

      <footer class="postFooter">
        ${post.pdfPath
          ? `<a class="pdf-link" href="${post.pdfPath}" target="_blank" rel="noopener noreferrer">View Original PDF</a>
             <span class="postFooter-divider"></span>`
          : ""
        }
        <button class="share-btn" id="shareBtn" aria-label="Share this post" type="button">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
          Share
        </button>
      </footer>
    </section>

    <script>
    (function() {
      var btn = document.getElementById('shareBtn');
      if (!btn) return;
      btn.addEventListener('click', function() {
        var shareData = {
          title: document.title,
          url: window.location.href
        };
        if (navigator.share) {
          navigator.share(shareData).catch(function() {});
        } else {
          navigator.clipboard.writeText(window.location.href).then(function() {
            var orig = btn.textContent;
            btn.textContent = 'Link copied!';
            setTimeout(function() {
              btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg> Share';
            }, 2000);
          });
        }
      });
    })();
    </script>
  `;
%>

<%- include("layout", { title: `${post.title} | The Augustine Journal`, active: post.type === "BLOG" ? "blog" : post.type === "ESSAY" ? "essays" : "letters", body }) %>

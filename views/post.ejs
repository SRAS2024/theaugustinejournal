<%- include("layout", {
  title: `${post.title} | The Augustine Journal`,
  titleFrom: "#postTitle",
  active: post.type === "BLOG" ? "blog" : post.type === "ESSAY" ? "essays" : "letters",
  body: include("pages/post", locals),
  ogTitle: post.title,
  ogDescription: (typeof description !== 'undefined' && description) || 'The Augustine Journal, thoughtful reflection and discourse.',
  ogUrl: `${typeof siteUrl !== 'undefined' ? siteUrl : 'https://theaugustinejournal.com'}/post/${encodeURIComponent(post.slug)}`,
  ogType: 'article',
  ogImage: `${typeof siteUrl !== 'undefined' ? siteUrl : 'https://theaugustinejournal.com'}/public/icons/icon-512.png`,
  ogImageWidth: '512',
  ogImageHeight: '512',
  jsonLd: typeof jsonLd !== 'undefined' ? jsonLd : undefined
}) %>
